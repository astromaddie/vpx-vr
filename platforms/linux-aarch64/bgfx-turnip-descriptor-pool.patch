+			// so the first set after a reset overruns a page-aligned pool.
+			dpci.flags = 0;
 			dpci.maxSets       = kDescriptorPoolChunkSize;
 			dpci.poolSizeCount = BX_COUNTOF(dps);
 			dpci.pPoolSizes    = dps;
