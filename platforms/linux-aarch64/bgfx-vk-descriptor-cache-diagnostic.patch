+
+		// Diagnostic switch for the per-frame descriptor-set cache, which reuses a set by a 32-bit hash
+		// of DescriptorSetKey without comparing the key itself, and whose key omits the program's own
+		// texture metadata (view type, MSAA) that getDescriptorSet() writes into the set.
+		// BGFX_VK_DESCRIPTOR_CACHE: unset or 1 = cache (default), 0 = bypass (allocate and write a set
+		// for every draw and dispatch), verify = cache, but compare full keys on every hit and warn once
+		// on a hash collision or on a set reused across programs with different texture metadata.
+		enum DescriptorCacheMode { DescriptorCacheDefault, DescriptorCacheBypass, DescriptorCacheVerify };
+
+		struct DescriptorSetKey
+		{
+			VkDescriptorSetLayout layout;
+			uint32_t msaaMask;
+			uint32_t bindIdx;
+			VkBuffer uniformBuffer;
+			uint32_t vsSize;
+			uint32_t fsSize;
+			VkImageLayout readOnlyDepthLayout;
+			uint16_t program; // Not hashed, only compared in verify mode
+		};
+
+		void initDescriptorCacheMode()
+		{
+			m_descriptorCacheMode = DescriptorCacheDefault;
+			m_descriptorCacheCollisionWarned = false;
+			m_descriptorCacheProgramWarned = false;
+			const char* mode = ::getenv("BGFX_VK_DESCRIPTOR_CACHE");
+			if (NULL == mode)
+			{
+				return;
+			}
+			if (0 == bx::strCmp(mode, "0") )
+			{
+				m_descriptorCacheMode = DescriptorCacheBypass;
+			}
+			else if (0 == bx::strCmp(mode, "verify") )
+			{
+				m_descriptorCacheMode = DescriptorCacheVerify;
+			}
+			bgfx::trace(__FILE__, uint16_t(__LINE__), "BGFX VK descriptor cache: mode %s (BGFX_VK_DESCRIPTOR_CACHE=%s)\n"
+				, DescriptorCacheBypass == m_descriptorCacheMode ? "bypass" : DescriptorCacheVerify == m_descriptorCacheMode ? "verify" : "default"
+				, mode
 				);
+		}
+
+		bool sameTextureMetadata(const ProgramVK& _a, const ProgramVK& _b) const
+		{
+			for (uint32_t stage = 0; stage < BGFX_CONFIG_MAX_TEXTURE_SAMPLERS; ++stage)
+			{
+				const BindInfo& a = _a.m_bindInfo[stage];
+				const BindInfo& b = _b.m_bindInfo[stage];
+				if (isValid(a.uniformHandle) != isValid(b.uniformHandle) )
+				{
+					return false;
+				}
+				if (!isValid(a.uniformHandle) )
+				{
+					continue;
+				}
+				if (a.type != b.type
+				||  a.binding != b.binding
+				||  a.samplerBinding != b.samplerBinding
+				||  (UINT32_MAX == a.index) != (UINT32_MAX == b.index) )
+				{
+					return false;
+				}
+				if (UINT32_MAX != a.index
+				&& (_a.m_textures[a.index].type != _b.m_textures[b.index].type
+				||  _a.m_textures[a.index].msaa != _b.m_textures[b.index].msaa) )
+				{
+					return false;
+				}
+			}
+			return true;
+		}
+
+		void verifyDescriptorSetKey(uint32_t _bindHash, const DescriptorSetKey& _key)
+		{
+			DescriptorSetKeyMap::const_iterator it = m_descriptorSetKeyMap.find(_bindHash);
+			if (it == m_descriptorSetKeyMap.end() )
+			{
+				return;
+			}
+			const DescriptorSetKey& cached = it->second;
+			if (cached.layout != _key.layout
+			||  cached.msaaMask != _key.msaaMask
+			||  cached.bindIdx != _key.bindIdx
+			||  cached.uniformBuffer != _key.uniformBuffer
+			||  cached.vsSize != _key.vsSize
+			||  cached.fsSize != _key.fsSize
+			||  cached.readOnlyDepthLayout != _key.readOnlyDepthLayout)
+			{
+				if (!m_descriptorCacheCollisionWarned)
+				{
+					m_descriptorCacheCollisionWarned = true;
+					bgfx::trace(__FILE__, uint16_t(__LINE__), "BGFX VK descriptor cache: WARNING hash 0x%08x collision, set of bind %u (program %u) reused for bind %u (program %u)\n"
+						, _bindHash, cached.bindIdx, cached.program, _key.bindIdx, _key.program
+						);
+				}
+			}
+			else if (cached.program != _key.program
+			&&  !sameTextureMetadata(m_program[cached.program], m_program[_key.program]) )
+			{
+				if (!m_descriptorCacheProgramWarned)
+				{
+					m_descriptorCacheProgramWarned = true;
+					bgfx::trace(__FILE__, uint16_t(__LINE__), "BGFX VK descriptor cache: WARNING set of program %u reused for program %u with different texture metadata (bind %u)\n"
+						, cached.program, _key.program, _key.bindIdx
+						);
+				}
+			}
+		}
 
+		VkDescriptorSet getCachedDescriptorSet(uint32_t _bindHash, const DescriptorSetKey& _key, const ProgramVK& _program, const RenderBind& _renderBind, VkBuffer _uniformBuffer, const float _palette[][4], uint32_t& _descriptorSetCount)
+		{
+			if (DescriptorCacheBypass == m_descriptorCacheMode)
+			{
+				++_descriptorSetCount;
+				return getDescriptorSet(_program, _renderBind, _uniformBuffer, _palette);
+			}
+
+			DescriptorSetMap::const_iterator it = m_descriptorSetMap.find(_bindHash);
+			if (it != m_descriptorSetMap.end() )
+			{
+				if (DescriptorCacheVerify == m_descriptorCacheMode)
+				{
+					verifyDescriptorSetKey(_bindHash, _key);
+				}
+				return it->second;
+			}
+
+			VkDescriptorSet descriptorSet = getDescriptorSet(_program, _renderBind, _uniformBuffer, _palette);
+			m_descriptorSetMap.insert(stl::make_pair(_bindHash, descriptorSet) );
+			if (DescriptorCacheVerify == m_descriptorCacheMode)
+			{
+				m_descriptorSetKeyMap.insert(stl::make_pair(_bindHash, _key) );
+			}
+			++_descriptorSetCount;
 			return descriptorSet;
 		}
 
