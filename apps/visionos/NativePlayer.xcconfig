PRODUCT_NAME = VPXVision
PRODUCT_BUNDLE_IDENTIFIER = org.vpinball.vpxvision.player
TARGETED_DEVICE_FAMILY = 7
SUPPORTED_PLATFORMS = xros xrsimulator
ARCHS[sdk=xrsimulator*] = arm64
XROS_DEPLOYMENT_TARGET = 26.0

INFOPLIST_FILE = NativePlayer/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = VPX Vision
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 24

SWIFT_OBJC_BRIDGING_HEADER = ../../lib/include/vpinball/VPinballVision.h
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(VPX_NATIVE_BUILD_DIR)"
OTHER_LDFLAGS = $(inherited) -framework vpinball
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_USER_SCRIPT_SANDBOXING = NO

ALWAYS_SEARCH_USER_PATHS = NO
